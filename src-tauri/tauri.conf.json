{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Delta-T Zaman",
  "version": "0.1.0",
  "identifier": "com.deltat.zaman",
  "build": {
    "beforeDevCommand": "cd src-ui && trunk serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd src-ui && trunk build",
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Delta-T Zaman",
        "width": 420,
        "height": 680,
        "minWidth": 320,
        "minHeight": 480,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://updater.example.com/update"
      ],
      "pubkey": "UPDATE_PUBKEY_PLACEHOLDER"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}